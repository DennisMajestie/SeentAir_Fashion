# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Managed hosts (Render, Railway, Heroku…) inject a single DATABASE_URL —
# set it and the DB_* values below are ignored.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=mac
DB_PASSWORD=
DB_NAME=seentair_dev
# SSL is inferred: on for a remote DATABASE_URL, off for localhost.
# Force it explicitly when needed — Render's INTERNAL hostname needs DB_SSL=false.
# DB_SSL=true

# Auth
JWT_SECRET=change-me-in-real-environments
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Mail (password reset) — leave SMTP_HOST empty in dev to log instead of send.
# SMTP_PORT 465 implies implicit TLS; 587/TLS handled via STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@seentair.com
RESET_URL_BASE=http://localhost:4200/reset-password
RESET_TTL_MINUTES=30
# Guest order tracking: where the emailed link points, and how long it lasts.
ORDER_URL_BASE=http://localhost:4200/orders
ORDER_TOKEN_TTL_DAYS=90
# Email confirmation. Verifying an address is what lets guest orders be
# claimed onto an account, so this link must work in production.
VERIFY_URL_BASE=http://localhost:4200/verify-email
VERIFY_TTL_MINUTES=1440

# Security hardening
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Leave this UNSET in production. Unset, it follows NODE_ENV and a deployed API
# gets SameSite=None; Secure. Set to false, the refresh cookie becomes
# SameSite=Lax, the browser withholds it on the cross-site call from the Vercel
# portals to /auth/refresh, and every session dies on page reload -- surfacing
# as 404 "Order not found", not as a login error. Copying this file into a
# production env with `false` is what caused that; only `true` is ever correct
# on HTTPS.
# COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203,https://seent-air-fashion.vercel.app,https://seentair-wholesale.vercel.app

# Business configuration (currency pending Open Question #6 — configurable, never hardcoded)
CURRENCY_CODE=NGN
CURRENCY_SYMBOL=₦
LOCALE=en-NG

# Wholesale minimum order quantity (confirmed: 20)
WHOLESALE_MOQ=20

# Production stages (comma-separated, customizable to real factory-floor terms; last = completion)
PRODUCTION_STAGES=Production Planned,Cutting,Sewing,Finishing,Quality Control,Completed

# Seed
SEED_USER_PASSWORD=Password123!

# Returns policy windows (confirmed: 12h request / 24h completion)
RETURN_REQUEST_WINDOW_HOURS=12
RETURN_COMPLETION_WINDOW_HOURS=24

# Media uploads. Driver: 'local' (dev) or 's3' (Supabase/R2/S3).
# local: photos written to MEDIA_UPLOADS_DIR (default <cwd>/uploads, git-ignored).
# s3: uses S3-compatible API (Supabase Storage / Cloudflare R2 / AWS S3).
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOADS_DIR=
# Public base the API advertises for uploaded files. Set behind a proxy/managed host.
# When empty, the API derives from the request's own origin (correct for local dev).
MEDIA_PUBLIC_URL=

# S3-compatible config (Supabase Storage / Cloudflare R2 / AWS S3) — used when MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=                  # e.g. https://<project-ref>.supabase.co/storage/v1/s3
MEDIA_S3_REGION=auto                # 'auto' for Supabase/R2, or AWS region
MEDIA_S3_BUCKET=                    # bucket name
MEDIA_S3_ACCESS_KEY_ID=             # storage API key
MEDIA_S3_SECRET_ACCESS_KEY=         # storage secret

# Integrations (leave empty until keys are provisioned)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack returns a customer after paying. The order id is appended, so
# this is the app root that owns /orders/:id - e.g. https://your-storefront.com
# Leave blank and Paystack shows its own success page, with no route back into
# the app. Set in Render for production.
PAYSTACK_CALLBACK_URL_BASE=
# Allow a payment init to send the receipt to an address other than the order
# customer's. Seeded accounts use the reserved `.test` TLD, which Paystack
# rejects, so local/CI runs need a real inbox. Defaults off in production.
PAYSTACK_EMAIL_OVERRIDE_ALLOWED=
# Where a charge is receipted when the buyer's own address is undeliverable.
# Every seeded account is @seentair.test and Paystack rejects the reserved TLD
# outright, so without this no local payment can be started at all. Set it to any
# inbox you control. Applied server-side and only where the override above is
# permitted, so a live buyer is never redirected off their own address.
PAYSTACK_DEV_INBOX=
GIGL_API_KEY=
TERMII_API_KEY=
SMS_SENDER_ID=Seentair

# Partner profit-sharing model (confirmed: 40/40/20, 1,000,000 shares, 60/40)
TOTAL_SHARES=1000000
FOUNDER_SHARE_PCT=60
PARTNERS_SHARE_PCT=40
PROFIT_REINVESTMENT_PCT=40
PROFIT_DIVIDENDS_PCT=40
PROFIT_RESERVE_PCT=20
# Unpaid orders are cancelled by a nightly sweep after this long.
UNPAID_ORDER_EXPIRY_HOURS=24
