# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=mac
DB_PASSWORD=
DB_NAME=seentair_dev

# Auth
JWT_SECRET=change-me-in-real-environments
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# Mail (password reset) — leave SMTP_HOST empty in dev to log instead of send
SMTP_HOST=
MAIL_FROM=no-reply@seentair.com
RESET_URL_BASE=http://localhost:4200/reset-password
RESET_TTL_MINUTES=30

# Security hardening
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# Business configuration (currency pending Open Question #6 — configurable, never hardcoded)
CURRENCY_CODE=NGN
CURRENCY_SYMBOL=₦
LOCALE=en-NG

# Wholesale minimum order quantity (confirmed: 20)
WHOLESALE_MOQ=20

# Production stages (comma-separated, customizable to real factory-floor terms; last = completion)
PRODUCTION_STAGES=Production Planned,Cutting,Sewing,Finishing,Quality Control,Completed

# Seed
SEED_USER_PASSWORD=Password123!

# Returns policy windows (confirmed: 12h request / 24h completion)
RETURN_REQUEST_WINDOW_HOURS=12
RETURN_COMPLETION_WINDOW_HOURS=24

# Integrations (leave empty until keys are provisioned)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
GIGL_API_KEY=
TERMII_API_KEY=
SMS_SENDER_ID=Seentair

# Partner profit-sharing model (confirmed: 40/40/20, 1,000,000 shares, 60/40)
TOTAL_SHARES=1000000
FOUNDER_SHARE_PCT=60
PARTNERS_SHARE_PCT=40
PROFIT_REINVESTMENT_PCT=40
PROFIT_DIVIDENDS_PCT=40
PROFIT_RESERVE_PCT=20
